# Sao chép thành .env và điền giá trị thật. KHÔNG commit file .env.
# Kết nối MySQL (ADR 0004). Hoặc điền DATABASE_URL đầy đủ
# (mysql+pymysql://user:pass@host:3306/loan_system?charset=utf8mb4), hoặc để trống và dùng các biến DB_*.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=loan_system
# Tài khoản ứng dụng: chỉ có quyền theo từng bảng, do create_database tạo và cấp quyền.
DB_USER=loan_app
DB_PASSWORD=
# Máy được phép kết nối bằng tài khoản ứng dụng ('%' = mọi máy, 'localhost' = chỉ máy CSDL).
DB_APP_HOST=%

# Tài khoản quản trị, chỉ dùng cho create_database và migration (tạo database, bảng, trigger, tài khoản
# ứng dụng). Điền DATABASE_ADMIN_URL hoặc cặp DB_ADMIN_*. Để trống cả hai thì tài khoản ứng dụng ở
# trên phải tự có đủ quyền, và không còn tách đặc quyền.
DATABASE_ADMIN_URL=
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# Bốn khóa bí mật tách biệt (mục 4.2.5 đề cương), mỗi khóa tối thiểu 32 byte ngẫu nhiên.
# Sinh bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
DATA_ENC_KEY=
HMAC_INTEGRITY_KEY=
BLIND_INDEX_KEY=
# Khi xoay HMAC_INTEGRITY_KEY: tăng phiên bản và giữ khóa cũ dạng JSON, ví dụ {"1": "khoa-cu"}.
HMAC_INTEGRITY_KEY_VERSION=1
HMAC_INTEGRITY_OLD_KEYS={}

# Chỉ dùng cho docker-compose: mật khẩu tài khoản root của container MySQL.
MYSQL_ROOT_PASSWORD=

# Thư mục lưu giấy tờ hồ sơ vay, nằm ngoài thư mục web (UC13). Mặc định var/documents.
DOCUMENT_STORAGE_DIR=

# Chỉ dùng khi chạy thử trên máy dev: ghi SMS (mã OTP) và email (mật khẩu tạm) giả lập ra log máy chủ.
DEV_ECHO_MESSAGES=false
