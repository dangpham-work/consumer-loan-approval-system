# Sao chép thành .env và điền giá trị thật. KHÔNG commit file .env.
# Kết nối SQL Server (ADR 0003). Hoặc điền DATABASE_URL đầy đủ, hoặc để trống và dùng các biến DB_*.
DATABASE_URL=
DB_HOST=localhost\MSSQLSERVER02
DB_NAME=loan_system
# Để trống DB_USER/DB_PASSWORD = Windows Authentication
DB_USER=
DB_PASSWORD=
ODBC_DRIVER=ODBC Driver 17 for SQL Server

# Bốn khóa bí mật tách biệt (mục 4.2.5 đề cương), mỗi khóa tối thiểu 32 byte ngẫu nhiên.
# Sinh bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
DATA_ENC_KEY=
HMAC_INTEGRITY_KEY=
BLIND_INDEX_KEY=

# Chỉ dùng cho docker-compose: mật khẩu tài khoản sa của container SQL Server (tối thiểu 8 ký tự, đủ loại ký tự).
MSSQL_SA_PASSWORD=

# Thư mục lưu giấy tờ hồ sơ vay, nằm ngoài thư mục web (UC13). Mặc định var/documents.
DOCUMENT_STORAGE_DIR=
